  let first : Inputs p := { data_data := (fun j => match j.val with | 0 => (BitVec.ofInt _ (0 : Int)) | _ => default), data_lanes := (fun j => match j.val with | 0 => (fun j => match j.val with | 0 => (BitVec.ofInt _ (0 : Int)) | _ => default) | _ => default), data_meta_code := (fun j => match j.val with | 0 => (BitVec.ofInt _ (3 : Int)) | _ => default), data_meta_flag := (fun j => match j.val with | 0 => true | _ => default), data_signed := (fun j => match j.val with | 0 => (BitVec.ofInt _ (2 : Int)) | _ => default), data_valid := (fun j => match j.val with | 0 => true | _ => default), enable := false, choose := false, index := (BitVec.ofInt _ (0 : Int)) }
  let mut state : State p := resetState p first
  let mut cycle : Nat := 0
  for entry in inputsTrace do
    let (inputs, reset) := entry
    if !outputDefined p inputs state && !(cycle == 0 && false) then throw (IO.userError "Undefined output operation in input trace")
    let pre := output p inputs state
    if !transitionDefined p inputs state reset then throw (IO.userError "Undefined transition operation in input trace")
    let next := step p inputs state reset
    if !outputDefined p inputs next then throw (IO.userError "Undefined output operation after clock edge")
    let post := output p inputs next
    IO.println (Lean.Json.mkObj [("cycle", Lean.toJson cycle), ("pre", outputsJson pre),
      ("post", outputsJson post), ("state", stateJson next)]).compress
    state := next
    cycle := cycle + 1
